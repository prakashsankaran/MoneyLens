# Copy to infrastructure/hosting/.env on the server and fill in. Never commit .env.
# Generate each secret with:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48

# The address people open, without https://. Its DNS must point at this server.
# A free DuckDNS name works, e.g. moneylens-prakash.duckdns.org
MONEYLENS_DOMAIN=

# Database password (only the containers use it).
POSTGRES_PASSWORD=

# Signs sign-in tokens. Changing it later signs everyone out.
JWT_ACCESS_SECRET=

# Who can create an account: invite (recommended), open or closed.
SIGNUP_MODE=invite
# One code per friend, comma-separated, 8 to 64 characters each.
# Remove a code to stop new sign-ups with it; accounts already made stay.
SIGNUP_INVITE_CODES=

# MoneyLens AI. Leave AI_PROVIDER=none to keep AI off for everyone, or set
# your Gemini settings and list the emails allowed to use them. Everyone not
# listed gets calculated figures only, and nothing of theirs is sent to Google.
AI_PROVIDER=none
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.1-flash-lite
# AI_API_KEY=
# AI_ALLOWED_EMAILS=you@example.com
AI_DAILY_MESSAGE_LIMIT=20

# Optional: email "Forgot password?" links from a free Gmail account
# (docs/PASSWORD_RESET.md). Without these, friends reset with their recovery key.
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your.moneylens@gmail.com
# SMTP_PASS=

# Nightly dumps kept on the server, in days.
BACKUP_KEEP_DAYS=14

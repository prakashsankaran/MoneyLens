// MoneyLens relational schema. See docs/DATABASE.md for the rationale.
//
// Conventions
// - Primary keys are cuid strings generated by Prisma.
// - Money is Decimal(14,2) in rupees; the API converts to integer paise at the
//   repository boundary and all arithmetic happens on integers.
// - Every user-owned row carries userId and cascades on user deletion so that
//   "delete my account" removes all financial data.

generator client {
  provider      = "prisma-client-js"
  // native for local development; debian-openssl-3.0.x for the Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirrored in packages/types)
// ---------------------------------------------------------------------------

enum TransactionType {
  DEBIT
  CREDIT
  REFUND
  CASHBACK
  TRANSFER
  SELF_TRANSFER
  UNKNOWN
}

enum TransactionFlow {
  OUT
  IN
}

enum TransactionSource {
  GOOGLE_PAY
  CSV
  XLSX
  MANUAL
  OTHER
}

enum TransactionStatus {
  CONFIRMED
  PENDING_REVIEW
  EXCLUDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  CASH
  WALLET
  OTHER
}

enum ImportStatus {
  UPLOADED
  PARSING
  READY_FOR_REVIEW
  CONFIRMED
  FAILED
  CANCELLED
}

enum ImportRowDecision {
  INCLUDE
  EXCLUDE
  DUPLICATE
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  IRREGULAR
}

enum InsightKind {
  FACT
  CALCULATION
  OBSERVATION
  AI_INTERPRETATION
  RECOMMENDATION
}

enum InsightSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
}

enum AIRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RuleMatchField {
  MERCHANT
  DESCRIPTION
  UPI_ID
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// argon2id hash. Plaintext passwords are never stored or logged.
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions          Session[]
  transactions      Transaction[]
  categories        Category[]
  merchants         Merchant[]
  imports           Import[]
  recurringPayments RecurringPayment[]
  insights          Insight[]
  budgets           Budget[]
  financialProfile  FinancialProfile?
  moneyPlans        MoneyPlan[]
  aiConversations   AIConversation[]
  categoryRules     UserCategoryRule[]
  authEvents        AuthEvent[]
}

enum AuthEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  /// Refused without checking the password: too many recent failures.
  LOGIN_BLOCKED
  /// A rotated refresh token was presented again; its session family was revoked.
  SESSION_REUSE_DETECTED
  LOGGED_OUT
  PASSWORD_CHANGED
  /// Every session was revoked at the owner's request.
  SIGNED_OUT_EVERYWHERE
}

/// Security log of sign-in activity, also used to slow down password
/// guessing per account. A failed sign-in for an unknown email has no user and
/// is keyed by an HMAC of the email, so the address itself is not stored.
/// Rows are deleted with the account and pruned after 90 days.
model AuthEvent {
  id        String        @id @default(cuid())
  userId    String?
  type      AuthEventType
  /// HMAC-SHA256 of the normalised email (keyed with the server secret).
  emailKey  String?
  userAgent String?
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([emailKey, createdAt])
  @@index([createdAt])
}

/// Refresh-token session. Only a SHA-256 hash of the token is stored, so a
/// database leak does not yield usable tokens. Rotated on every refresh.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  /// Sessions created by rotation share a family; reuse of a revoked token
  /// revokes the whole family (refresh-token theft detection).
  familyId   String
  userAgent  String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ---------------------------------------------------------------------------
// Categorisation
// ---------------------------------------------------------------------------

/// Hierarchical categories. Top-level rows have parentId = null; subcategories
/// point at their parent. System categories have userId = null and are shared;
/// custom categories belong to one user.
model Category {
  id        String   @id @default(cuid())
  userId    String?
  parentId  String?
  name      String
  slug      String
  icon      String?
  color     String?
  isSystem  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  transactions            Transaction[]       @relation("TransactionCategory")
  subcategoryTransactions Transaction[]       @relation("TransactionSubcategory")
  merchantDefaults        Merchant[]          @relation("MerchantDefaultCategory")
  merchantOverrides       Merchant[]          @relation("MerchantUserCategory")
  budgets                 Budget[]
  rules                   UserCategoryRule[]
  importRows              ImportTransaction[]

  // Postgres treats NULLs as distinct, so system slugs are additionally
  // protected by a partial unique index created in the initial migration.
  @@unique([userId, parentId, slug])
  @@index([parentId])
}

/// A normalised merchant ("Swiggy") that many raw descriptions map to.
model Merchant {
  id                String   @id @default(cuid())
  userId            String
  name              String
  normalizedName    String
  defaultCategoryId String?
  /// User's explicit choice; wins over defaultCategoryId.
  userCategoryId    String?
  /// 0..1 confidence of the default category assignment.
  confidence        Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory Category?          @relation("MerchantDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  userCategory    Category?          @relation("MerchantUserCategory", fields: [userCategoryId], references: [id], onDelete: SetNull)
  aliases         MerchantAlias[]
  transactions    Transaction[]
  recurring       RecurringPayment[]

  @@unique([userId, normalizedName])
  @@index([userId])
}

/// Raw strings seen in statements ("SWIGGY*FOOD", "Swiggy India").
model MerchantAlias {
  id         String   @id @default(cuid())
  merchantId String
  alias      String
  /// Uppercased, whitespace-collapsed alias used for matching.
  aliasKey   String
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, aliasKey])
  @@index([aliasKey])
}

/// A user correction promoted to a rule for future imports.
model UserCategoryRule {
  id         String         @id @default(cuid())
  userId     String
  matchField RuleMatchField
  /// Case-insensitive substring to match.
  pattern    String
  categoryId String
  priority   Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, matchField, pattern])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Transactions & imports
// ---------------------------------------------------------------------------

model Transaction {
  id                   String            @id @default(cuid())
  userId               String
  transactionDate      DateTime          @db.Timestamptz(3)
  /// Always positive; direction is given by `flow`.
  amount               Decimal           @db.Decimal(14, 2)
  currency             String            @default("INR") @db.Char(3)
  transactionType      TransactionType
  flow                 TransactionFlow
  merchantId           String?
  /// Display name as resolved at import time (denormalised for history).
  merchantName         String?
  description          String?
  categoryId           String?
  subcategoryId        String?
  paymentMethod        PaymentMethod?
  /// Counterparty UPI handle. Masked in API responses by default.
  upiId                String?
  /// Bank/UPI reference number. Masked in API responses by default.
  transactionReference String?
  source               TransactionSource
  sourceFileId         String?
  status               TransactionStatus @default(CONFIRMED)
  isRecurring          Boolean           @default(false)
  recurringGroupId     String?
  /// 0..1 confidence of the category assignment.
  categoryConfidence   Float?
  notes                String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant       Merchant?           @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  category       Category?           @relation("TransactionCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory    Category?           @relation("TransactionSubcategory", fields: [subcategoryId], references: [id], onDelete: SetNull)
  sourceFile     Import?             @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  recurringGroup RecurringPayment?   @relation(fields: [recurringGroupId], references: [id], onDelete: SetNull)
  importRows     ImportTransaction[]

  @@index([userId, transactionDate])
  @@index([userId, categoryId])
  @@index([userId, merchantId])
  @@index([userId, transactionType])
  @@index([sourceFileId])
  @@index([userId, transactionReference])
}

/// One uploaded statement file and its processing state.
model Import {
  id               String            @id @default(cuid())
  userId           String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  /// SHA-256 of the file bytes; detects re-uploading the same statement.
  sha256           String
  /// Storage key, not a public URL. Raw files can be deleted after confirm.
  storageKey       String?
  source           TransactionSource
  parserName       String?
  status           ImportStatus      @default(UPLOADED)
  statementStart   DateTime?         @db.Date
  statementEnd     DateTime?         @db.Date
  detectedCount    Int               @default(0)
  duplicateCount   Int               @default(0)
  committedCount   Int               @default(0)
  errorMessage     String?
  /// File-level parser warnings shown on the review screen.
  warnings         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  confirmedAt      DateTime?

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows         ImportTransaction[]
  transactions Transaction[]

  @@index([userId, createdAt])
  @@index([userId, sha256])
}

/// A parsed, normalised row awaiting user review before it becomes a
/// Transaction. Nothing is committed until the user confirms the import.
model ImportTransaction {
  id                   String            @id @default(cuid())
  importId             String
  rowIndex             Int
  transactionDate      DateTime          @db.Timestamptz(3)
  amount               Decimal           @db.Decimal(14, 2)
  transactionType      TransactionType
  flow                 TransactionFlow
  rawDescription       String?
  merchantName         String?
  categoryId           String?
  categoryConfidence   Float?
  upiId                String?
  transactionReference String?
  decision             ImportRowDecision @default(INCLUDE)
  /// Existing transaction this row may duplicate (never auto-deleted).
  duplicateOfId        String?
  duplicateReason      String?
  /// Parser warnings for this row, e.g. ambiguous date format.
  warnings             Json?
  committedId          String?
  createdAt            DateTime          @default(now())

  importRecord Import       @relation(fields: [importId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  duplicateOf  Transaction? @relation(fields: [duplicateOfId], references: [id], onDelete: SetNull)

  @@unique([importId, rowIndex])
  @@index([importId])
}

// ---------------------------------------------------------------------------
// Analysis outputs
// ---------------------------------------------------------------------------

model RecurringPayment {
  id              String             @id @default(cuid())
  userId          String
  /// Stable identity of the detected series (merchant, direction and, for a
  /// merchant with mixed payments, amount band). Keeps a dismissal across
  /// re-detection.
  key             String
  flow            TransactionFlow    @default(OUT)
  merchantId      String?
  label           String
  frequency       RecurringFrequency
  typicalAmount   Decimal            @db.Decimal(14, 2)
  lastChargedAt   DateTime?
  nextExpectedAt  DateTime?
  occurrenceCount Int                @default(0)
  confidence      Float              @default(0)
  isSubscription  Boolean            @default(false)
  /// False once a payment was missed when the next one was due.
  isActive        Boolean            @default(true)
  dismissedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant     Merchant?     @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@unique([userId, key])
}

/// A persisted insight produced by the deterministic engine (or, labelled as
/// such, by the AI layer). `kind` makes provenance explicit.
model Insight {
  id                       String          @id @default(cuid())
  userId                   String
  /// Stable key for deduplication, e.g. "category-above-average:food:2026-09".
  key                      String
  kind                     InsightKind
  severity                 InsightSeverity
  group                    String
  title                    String
  explanation              String
  recommendation           String?
  metric                   Json
  confidence               Float
  supportingTransactionIds String[]
  periodStart              DateTime        @db.Date
  periodEnd                DateTime        @db.Date
  dismissedAt              DateTime?
  createdAt                DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, periodStart])
}

// ---------------------------------------------------------------------------
// Planning
// ---------------------------------------------------------------------------

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  /// First day of the budget month (IST).
  month      DateTime @db.Date
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

/// Self-declared financial profile used by the money planner.
model FinancialProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  monthlyIncome        Decimal? @db.Decimal(14, 2)
  fixedExpenses        Decimal? @db.Decimal(14, 2)
  emis                 Decimal? @db.Decimal(14, 2)
  insurance            Decimal? @db.Decimal(14, 2)
  investments          Decimal? @db.Decimal(14, 2)
  savingsTarget        Decimal? @db.Decimal(14, 2)
  emergencyFundTarget  Decimal? @db.Decimal(14, 2)
  /// Emergency fund already saved.
  emergencyFundCurrent Decimal? @db.Decimal(14, 2)
  /// [{ label, amount, dueMonth }]
  upcomingExpenses     Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MoneyPlan {
  id            String   @id @default(cuid())
  userId        String
  name          String
  /// Inputs and computed allocation, versioned by `schemaVersion`.
  inputs        Json
  allocation    Json
  schemaVersion Int      @default(1)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// AI assistant
// ---------------------------------------------------------------------------

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           AIRole
  content        String
  /// Which provider/model answered, and the analytic context ids it was given.
  provider       String?
  contextRef     Json?
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

# Copy to apps/api/.env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://moneylens:moneylens@localhost:5432/moneylens?schema=public

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

LOG_LEVEL=info
# Upload limits are enforced from Phase 2 (imports).
MAX_UPLOAD_MB=10

# MoneyLens AI (Phase 6). With AI_PROVIDER=none the assistant shows the
# calculated figures only and says AI is not set up.
# anthropic: set AI_API_KEY (AI_MODEL defaults to claude-sonnet-5-5).
# openai-compatible: set AI_API_KEY, AI_BASE_URL and AI_MODEL.
AI_PROVIDER=none
# AI_MODEL=
# AI_API_KEY=
# AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=700
AI_TIMEOUT_MS=30000
AI_DAILY_MESSAGE_LIMIT=50
AI_CHAT_RATE_LIMIT=10
